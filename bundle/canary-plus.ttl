# SPDX-License-Identifier: GPL-3.0-or-later
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<urn:davidian:canary-plus>
	a lv2:Plugin , lv2:DistortionPlugin ;
	doap:name "Davidian Canary Plus" ;
	doap:license <http://opensource.org/licenses/GPL-3.0> ;
	rdfs:comment "Circuit model of an op-amp gain stage driving a diode clipper. Written with AI assistance (Claude, by Anthropic)." ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 2 ;
		lv2:symbol "distortion" ;
		lv2:name "Distortion" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 3 ;
		lv2:symbol "output" ;
		lv2:name "Output" ;
		lv2:default 0.8 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ;
		lv2:symbol "diode" ;
		lv2:name "Diodes" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 4 ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:scalePoint [ rdfs:label "1N270 germanium (original)" ; rdf:value 0 ] ,
			[ rdfs:label "1N34 germanium (fuzzy)" ; rdf:value 1 ] ,
			[ rdfs:label "1N4148 silicon (buzz)" ; rdf:value 2 ] ,
			[ rdfs:label "LED (crunch)" ; rdf:value 3 ] ,
			[ rdfs:label "1N34 array (asymmetric)" ; rdf:value 4 ]
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ;
		lv2:symbol "input_volts" ;
		lv2:name "Volts at 0 dBFS" ;
		rdfs:comment "Input voltage that a full-scale digital signal represents. Higher values drive the circuit harder." ;
		lv2:default 1.0 ;
		lv2:minimum 0.1 ;
		lv2:maximum 10.0 ;
		lv2:portProperty pprop:logarithmic
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:designation lv2:enabled ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:integer , lv2:toggled
	] , [
		a lv2:ControlPort , lv2:OutputPort ;
		lv2:index 7 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:designation lv2:latency ;
		lv2:minimum 0 ;
		lv2:maximum 64 ;
		lv2:portProperty lv2:reportsLatency , lv2:integer
	] , [
		a lv2:ControlPort , lv2:OutputPort ;
		lv2:index 8 ;
		lv2:symbol "clip" ;
		lv2:name "Clip" ;
		rdfs:comment "How hard the diodes are clipping, for the GUI's clip lamp." ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] .
